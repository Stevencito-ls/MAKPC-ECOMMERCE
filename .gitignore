# ==============================================================================
# .gitignore - MAKPC Enterprises S.A.C.
# ==============================================================================

# Variables de entorno y credenciales locales (usar .env.example como plantilla)
.env
ecommerce/.env

# Configuración de entornos de desarrollo e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Archivos temporales y de sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# Archivos de registro / Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Respaldos y archivos temporales
*.tmp
*.bak
*.swp
