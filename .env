SECURE_COOKIES=false


# Pasarela de Pagos Online Culqi (Sandbox)

CULQI_PUBLIC_KEY=pk_test_b8e5dbad0a0ff6a2

CULQI_PRIVATE_KEY=sk_test_615bc063ca8bb233


# API de Consulta DNI y RUC (https://apisperu.com/)

