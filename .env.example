# ==============================================================================
# CONFIGURACIÓN DE ENTORNO MAKPC ENTERPRISES S.A.C.
# Para producción en la nube (Docker, AWS, VPS, Cloud Run) o local
# ==============================================================================

# Entorno: development | production
APP_ENV=development
APP_DEBUG=true

# URL Base de la aplicación (dejar vacío para autodetección dinámica o especificar)
# Ejemplos:
# Local: /MAKPC/
# Producción en dominio raíz: https://makpc.com/
# Producción en subdirectorio: https://servidor.com/sistema/
BASE_URL=/MAKPC/

# Base de Datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taller_servicios
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Seguridad y Sesiones
SESSION_LIFETIME=7200
SECURE_COOKIES=false

# Pasarela de Pagos Online Culqi (Yape, Tarjetas, PagoEfectivo)
# Llaves de prueba por defecto (Sandbox). Reemplazar con pk_live / sk_live para cobros reales
CULQI_PUBLIC_KEY=pk_test_b8e5dbad0a0ff6a2
CULQI_PRIVATE_KEY=sk_test_615bc063ca8bb233
